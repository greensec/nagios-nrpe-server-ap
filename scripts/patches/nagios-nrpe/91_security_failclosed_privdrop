 	/* drop and then check privileges */
-	drop_privileges(nrpe_user, nrpe_group, 0);
+	if (drop_privileges(nrpe_user, nrpe_group, 0) == ERROR) {
+		logit(LOG_ERR, "Error: failed to drop privileges - exiting");
+		exit(STATE_CRITICAL);
+	}
 	check_privileges();
 }
 
@@ -2201,7 +2204,9 @@

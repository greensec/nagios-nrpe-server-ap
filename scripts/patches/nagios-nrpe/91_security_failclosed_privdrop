+		if (drop_privileges(nrpe_user, nrpe_group, 1) == ERROR)
+			exit(STATE_CRITICAL);
 		close(fd[0]);			/* close pipe for reading */
 		setpgid(0, 0);			/* become process group leader */
 
@@ -2356,8 +2361,10 @@
 			grp = (struct group *)getgrnam(group);

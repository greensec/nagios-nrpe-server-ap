Description: Enable command arguments and the nrpe.d include directory
 Ships the two packaging deltas this repository exists for:
 * dont_blame_nrpe=1 - combined with --enable-command-args (added to
   debian/rules by scripts/prepare/nagios-nrpe.sh) this lets the daemon
   accept arguments passed by check_nrpe -a.
 * include_dir=/etc/nagios/nrpe.d/ moved next to the options it relates
   to - local command definitions can be dropped in as *.cfg snippets.
Origin: vendor
Forwarded: not-needed

---
--- nagios-nrpe-ap-4.0.3.orig/sample-config/nrpe.cfg.in
+++ nagios-nrpe-ap-4.0.3/sample-config/nrpe.cfg.in
@@ -119,7 +119,7 @@ allowed_hosts=127.0.0.1,::1
 #
 # Values: 0=do not allow arguments, 1=allow command arguments
 
-dont_blame_nrpe=0
+dont_blame_nrpe=1
 
 
 
@@ -362,18 +362,15 @@ command[check_total_procs]=@pluginsdir@/
 #include_dir=<somedirectory>
 #include_dir=<someotherdirectory>
 
+# you can place your config snipplets into nrpe.d/
+# only snipplets ending in .cfg will get included
 
+include_dir=/etc/nagios/nrpe.d/
 
 # local configuration:
 # if you'd prefer, you can instead place directives here
-
 include=/etc/nagios/nrpe_local.cfg
 
-# you can place your config snipplets into nrpe.d/
-# only snipplets ending in .cfg will get included
-
-include_dir=/etc/nagios/nrpe.d/
-
 
 # KEEP ENVIRONMENT VARIABLES
 # This directive allows you to retain specific variables from the environment

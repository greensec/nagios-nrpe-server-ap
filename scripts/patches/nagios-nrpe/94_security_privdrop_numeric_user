 		/* set effective user ID if other than current EUID */
 #ifdef HAVE_INITGROUPS
+			const char *ig_user = NULL;
+			gid_t      ig_gid = gid;
+			struct passwd *ig_pw = pw;
+
+			/* resolve a passwd entry for initgroups when user was numeric */
+			if (ig_pw == NULL)
+				ig_pw = getpwuid(uid);
+			if (ig_pw != NULL) {
+				ig_user = ig_pw->pw_name;
+				if (ig_gid == (gid_t)-1)
+					ig_gid = ig_pw->pw_gid;
+			}
+
 			/* initialize supplementary groups */
-			if (initgroups(user, gid) == -1) {

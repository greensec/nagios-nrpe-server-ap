Description: Retry EAGAIN in sendall() on non-blocking sockets
 The accepted client socket is O_NONBLOCK (upstream bf4afc8), but
 sendall() aborted on the first send() error including EAGAIN, so a
 slow or stalled client could receive a truncated response. sendall()
 now retries on EAGAIN until the socket timeout, mirroring recvall(),
 and takes the timeout as an argument (call sites pass socket_timeout).
Origin: vendor
Forwarded: not-needed
---
--- a/src/utils.c	2026-10-03 00:40:27.485387202 +0200
+++ b/src/utils.c	2026-10-03 01:13:40.914366849 +0200
@@ -389,16 +389,27 @@
 }
 
 /* sends all data - thanks to Beej's Guide to Network Programming */
-int sendall(int s, char *buf, int *len)
+int sendall(int s, char *buf, int *len, int timeout)
 {
+	time_t start_time;
+	time_t current_time;
 	int total = 0;
 	int bytesleft = *len;
 	int n = 0;
 
+	time(&start_time);
+
 	/* send all the data */
 	while (total < *len) {
 		n = send(s, buf + total, bytesleft, 0);	/* send some data */
-		if (n == -1)			/* break on error */
+		if (n == -1 && errno == EAGAIN) {
+			/* socket buffer full (non-blocking socket) - retry until timeout */
+			time(&current_time);
+			if (current_time - start_time > timeout)
+				break;
+			sleep(1);
+			continue;
+		} else if (n == -1)			/* break on error */
 			break;
 		/* apply bytes we sent */
 		total += n;

FROM debian:bookworm

ADD assets/dpkg_nodoc /etc/dpkg/dpkg.cfg.d/90_nodoc
ADD assets/dpkg_nolocale /etc/dpkg/dpkg.cfg.d/90_nolocale
ADD assets/apt_nocache /etc/apt/apt.conf.d/90_nocache
ADD assets/apt_mindeps /etc/apt/apt.conf.d/90_mindeps

ARG DEBIAN_FRONTEND=noninteractive

# default dependencies
RUN set -e \
    && apt-get update \
    && apt-get -y install wget ca-certificates gnupg quilt vim debhelper build-essential lsb-release dh-python \
    && apt-get build-dep nagios-nrpe-server \
    && apt-get -y install nagios-nrpe-server \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/* /var/log/*


ADD	scripts/ /root/.
ADD run.sh /root/.
